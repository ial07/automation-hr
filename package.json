{
  "name": "automation-hr-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/frontend\" \"npm run start:dev -w apps/backend\"",
    "build": "npm run build -w apps/backend",
    "build:backend": "npm run build -w apps/backend",
    "lint": "npm run lint --workspaces --if-present",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
